# Stage 1: Build frontend assets with Vite
FROM node:22-alpine AS frontend-builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Production runtime image with FrankenPHP & PHP 8.4
FROM dunglas/frankenphp:1-php8.4

WORKDIR /app

# Install system dependencies and required PHP extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && install-php-extensions \
        pdo_mysql \
        intl \
        zip \
        bcmath \
        pcntl \
        opcache

# Install Composer 2
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure production PHP settings
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && echo "variables_order = \"EGPCS\"" >> "$PHP_INI_DIR/conf.d/docker-vars.ini" \
    && echo "expose_php = Off" >> "$PHP_INI_DIR/conf.d/docker-vars.ini" \
    && echo "upload_max_filesize = 32M" >> "$PHP_INI_DIR/conf.d/docker-vars.ini" \
    && echo "post_max_size = 32M" >> "$PHP_INI_DIR/conf.d/docker-vars.ini" \
    && echo "memory_limit = 256M" >> "$PHP_INI_DIR/conf.d/docker-vars.ini"

# Copy composer dependency definitions first for optimal layer caching
COPY composer.json composer.lock ./

# Install production PHP dependencies
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-autoloader \
    --no-scripts \
    --prefer-dist

# Copy the entire Laravel application
COPY . .

# Copy compiled Vite assets from frontend-builder stage
COPY --from=frontend-builder /app/public/build ./public/build

# Complete composer autoloader and discover packages without baking environment configuration
RUN composer dump-autoload --optimize --no-dev \
    && php artisan package:discover --ansi \
    && php artisan filament:upgrade \
    && php artisan storage:link || true

# Copy Caddyfile configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Ensure all runtime directories exist with correct permissions for www-data
RUN mkdir -p \
    storage/app/public \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    /data/caddy \
    /config/caddy \
    && chown -R www-data:www-data /app /data/caddy /config/caddy /etc/caddy/Caddyfile \
    && chmod -R 775 storage bootstrap/cache \
    && setcap cap_net_bind_service=+ep /usr/local/bin/frankenphp || true

# Run as non-root user
USER www-data

# Default Vercel port (overridden by $PORT at runtime)
ENV PORT=80

EXPOSE 80

# Start FrankenPHP using custom Caddyfile
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
